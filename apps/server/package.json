{
  "name": "@binlight/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@binlight/source src/main.ts",
    "build": "tsc -b",
    "start": "node dist/main.js",
    "rea:tools": "tsx --conditions=@binlight/source src/cli/rea-tools.ts",
    "contracts:record": "tsx --conditions=@binlight/source src/contracts/record.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "preflight": "tsx --conditions=@binlight/source src/cli/preflight.ts",
    "serve": "tsx --conditions=@binlight/source src/main.ts"
  },
  "dependencies": {
    "@binlight/shared": "*",
    "@modelcontextprotocol/client": "2.3.1",
    "rea-agents": "6.7.0",
    "zod": "^4.6.7"
  }
}
